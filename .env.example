# --- SSH MCP Server configuration ---
# Port/host the MCP server listens on
MCP_PORT=8844
MCP_HOST=127.0.0.1

# API key for clients. Generate one, e.g.:
#   python3 -c "import secrets; print('mcp_' + secrets.token_hex(24))"
MCP_API_KEY=

# --- Default SSH target used by the remote_output / ssh_execute tool ---
DEFAULT_SSH_HOST=127.0.0.1
DEFAULT_SSH_PORT=22
DEFAULT_SSH_USER=
DEFAULT_SSH_KEY_PATH=
# DEFAULT_SSH_PASSWORD=
